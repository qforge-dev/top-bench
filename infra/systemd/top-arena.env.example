# Runtime
TOP_ARENA_ENVIRONMENT=production
TOP_ARENA_LOG_LEVEL=INFO
TOP_ARENA_SERVER_HOST=127.0.0.1
TOP_ARENA_SERVER_PORT=8910
TOP_ARENA_PUBLIC_BASE_URL=https://top-arena.labqoat.com

# Local PostgreSQL over its Unix socket. Ubuntu's default peer authentication
# maps the systemd User=ubuntu process to the PostgreSQL role named ubuntu.
TOP_ARENA_DATABASE_URL=postgresql+psycopg://ubuntu@/top_arena?host=/var/run/postgresql

# The EC2 instance role supplies AWS credentials. Do not put static credentials here.
TOP_ARENA_STORAGE_BACKEND=s3
TOP_ARENA_S3_BUCKET=qlamp-training-artifacts-088543363904
TOP_ARENA_S3_PREFIX=parametric-amplifier/public/top-arena
TOP_ARENA_S3_REGION=us-east-1

# Four single-threaded workers keep concurrent runs moving without CPU oversubscription.
TOP_ARENA_SCORE_WORKER_COUNT=4
TOP_ARENA_SCORE_POLL_INTERVAL_SECONDS=0.25
TOP_ARENA_RUN_COMPLETION_TIMEOUT_SECONDS=600
