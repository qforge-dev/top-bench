[Unit]
Description=TOP Arena completed NAM dataset activator
After=network-online.target postgresql.service top-arena.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/top-bench
EnvironmentFile=/etc/top-arena/top-arena.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/top-bench/.venv/bin/python -m tools.nam_baselines.activate --bucket qlamp-training-artifacts-088543363904 --prefix parametric-amplifier/public/top-arena/reference-corpus/v1 --poll-seconds 60
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
