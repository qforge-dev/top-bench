[Unit]
Description=TOP Arena two-GPU NAM A2 Full baseline factory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/top-bench
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/top-bench/.venv/bin/python /home/ubuntu/top-bench/tools/nam_baselines/bestia_worker.py --root /home/ubuntu/top-arena-nam-a2 --bucket qlamp-training-artifacts-088543363904 --prefix parametric-amplifier/public/top-arena/reference-corpus/v1/nam-a2-full/v1 --nam-bin /opt/dlami/nvme/nam-venv/bin/nam-full --nam-python /opt/dlami/nvme/nam-venv/bin/python --repo /home/ubuntu/top-bench --gpus 2,3 --epochs 200 --inference-workers 4 --poll-seconds 10
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
